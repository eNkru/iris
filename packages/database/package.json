{
  "name": "@iris/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./drizzle/schema": "./src/drizzle/schema/index.ts",
    "./drizzle/schema/auth": "./src/drizzle/schema/auth.ts",
    "./drizzle/schema/sqlite": "./src/drizzle/schema/sqlite.ts",
    "./drizzle/client": "./src/drizzle/client.ts",
    "./drizzle/queries": "./src/drizzle/queries/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:runtime": "tsx src/migrate.ts",
    "db:migrate:build": "esbuild src/migrate.ts --bundle --platform=node --format=cjs --outfile=dist/migrate.cjs --external:better-sqlite3",
    "db:seed": "tsx src/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@iris/utils": "workspace:*",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.44.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.0",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
