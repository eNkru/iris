[TEMPLATE]
# ---------------------------------------------------------------------------
# Iris — price tracking & alert app
# Copy to .env and adjust. Secrets are never committed.
# ---------------------------------------------------------------------------

# App
NODE_ENV=development
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=dev-secret-change-me

# SQLite database. The parent directory is created automatically.
DATABASE_PATH=./data/iris.db

# SMTP — magic-link login emails (and future email alert channel)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@localhost

# AI (OpenAI-compatible) — instance-level config is admin-editable at runtime.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Optional: throttle generateText so free-tier Zen 429s don't fail checks.
# AI_EXTRACT_CONCURRENCY=1
# AI_EXTRACT_MIN_INTERVAL_MS=2000

# Telegram alert channel
TELEGRAM_BOT_TOKEN=

# Scheduler — in-process loop interval
SCHEDULER_TICK_MS=30000

# Argus — the external anti-detect fetch service (deployed from the argus
# repo). For `pnpm dev`, run argus locally (e.g. ../argus/dev.sh) and keep
# this loopback URL. ARGUS_API_TOKEN must match one of argus's
# ARGUS_API_TOKENS values.
ARGUS_BASE_URL=http://localhost:8000
ARGUS_API_TOKEN=
